<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AccountEditorActivity">
<!--    <include layout="@layout/toolbar" />-->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_stock_editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"

        app:menu="@menu/testing_menu"
        app:title="Stock Editor"
        app:titleMarginStart="40dp"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />


    <TableLayout
        android:id="@+id/AccountInputTable"
        style="@style/tableBuffer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="60dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <TableRow
            android:layout_width="fill_parent"
            android:layout_height="50dp"
            android:background="@drawable/bordered_square">

            <TextView
                android:id="@+id/StockNamePrompt"
                android:layout_width="115dp"
                android:layout_height="fill_parent"
                android:text=" Account Name"
                android:textSize="16sp"
                android:background="@drawable/bordered_square"/>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/StockNameInput"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:hint="hint"
                android:textSize="16sp"
                background="@drawable/bordered_square"/>

            <!--            <com.google.android.material.textfield.TextInputLayout-->
            <!--                android:layout_width="fill_parent"-->
            <!--                android:layout_height="fill_parent"-->

            <!--                android:background="@drawable/bordered_square">-->

            <!--                -->

            <!--            </com.google.android.material.textfield.TextInputLayout>-->

        </TableRow>

        <TableRow
            android:layout_width="fill_parent"
            android:layout_height="50dp"
            android:background="@drawable/bordered_square"
            android:orientation="vertical"
            >

            <!--            <EditText-->
            <!--                android:id="@+id/editTextNumberDecimal"-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:ems="10"-->
            <!--                android:hint="Balance Change \nValue"-->
            <!--                android:inputType="numberDecimal"-->
            <!--                android:textSize="16sp" />-->
            <TextView
                android:id="@+id/StockPricePrompt"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text=" Balance Change \n Amount"
                android:textSize="16sp"
                android:background="@drawable/bordered_square"
                />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/StockPriceInput"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:ems="10"
                android:hint="Balance Change Value"
                android:inputType="numberDecimal"
                android:textSize="16sp" />

            <!--            <com.google.android.material.textfield.TextInputLayout-->
            <!--                android:layout_width="fill_parent"-->
            <!--                android:layout_height="fill_parent"-->

            <!--                android:background="@drawable/bordered_square">-->

            <!--                -->

            <!--            </com.google.android.material.textfield.TextInputLayout>-->
        </TableRow>
        <TableRow
            android:layout_width="fill_parent"
            android:layout_height="50dp"
            android:background="@drawable/bordered_square"
            android:orientation="vertical"
            >

            <!--            <EditText-->
            <!--                android:id="@+id/editTextNumberDecimal"-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:ems="10"-->
            <!--                android:hint="Balance Change \nValue"-->
            <!--                android:inputType="numberDecimal"-->
            <!--                android:textSize="16sp" />-->
            <TextView
                android:id="@+id/StockAmountPrompt"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text=" Balance Change \n Amount"
                android:textSize="16sp"
                android:background="@drawable/bordered_square"
                />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/StockAmountInput"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:ems="10"
                android:hint="Balance Change Value"
                android:inputType="numberDecimal"
                android:textSize="16sp" />

            <!--            <com.google.android.material.textfield.TextInputLayout-->
            <!--                android:layout_width="fill_parent"-->
            <!--                android:layout_height="fill_parent"-->

            <!--                android:background="@drawable/bordered_square">-->

            <!--                -->

            <!--            </com.google.android.material.textfield.TextInputLayout>-->
        </TableRow>
        <TableRow
            android:layout_width="fill_parent"
            android:layout_height="50dp"
            android:background="@drawable/bordered_square">
            <TextView
                android:id="@+id/StockNotesPrompt"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:text=" Editing Which \n Account?"
                android:textSize="16sp"
                android:background="@drawable/bordered_square"/>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/StockNotesInput"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:hint="hint"
                android:textSize="16sp" />
            <!--            <com.google.android.material.textfield.TextInputLayout-->
            <!--                android:layout_width="fill_parent"-->
            <!--                android:layout_height="fill_parent"-->

            <!--                android:background="@drawable/bordered_square">-->

            <!--                -->
            <!--            </com.google.android.material.textfield.TextInputLayout>-->

        </TableRow>

    </TableLayout>


    <Button
        android:id="@+id/SaveButton"
        style="@style/firstStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:layout_marginTop="88dp"
        android:text="Save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/AccountInputTable" />

</androidx.constraintlayout.widget.ConstraintLayout>